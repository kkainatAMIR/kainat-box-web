# The React app uses same-origin /api routes by default. Set this only when the API
# is hosted on a different HTTPS origin.
VITE_API_URL=
VITE_FORMS_ENDPOINT=

# Neon PostgreSQL connection string (the only database configuration the app needs).
# Use the POOLED endpoint (host contains "-pooler") for Vercel/serverless:
#   postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require
DATABASE_URL=

# Optional database tuning (safe defaults are used when unset):
# DATABASE_SSL=disable        # only for a local Postgres without TLS
# DATABASE_SSL_STRICT=false   # only when a local proxy uses a self-signed cert
# DATABASE_POOL_MAX=2

PORT=4000

# Set true only when the site and API are served over HTTPS in production.
# On Vercel NODE_ENV=production already enables secure cookies automatically.
COOKIE_SECURE=false

# server.js applies pending migrations on boot by default. Set to true to skip
# (migrations can always be applied manually with: npm run migrate)
# SKIP_BOOT_MIGRATIONS=true

# Optional email notification settings. Every submission is saved to the
# database even when SMTP is not configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_TO=

# Add payment provider secrets only to the server environment.
# Never expose Stripe/PayFast/PayPro secret keys in VITE_ variables.
